# SQLAlchemy async URLs. Use postgresql+psycopg://... for PostgreSQL.
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL_POOLED=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

S3_BUCKET_NAME=your-bucket
S3_REGION=ap-southeast-2
# Optional when the runtime supplies AWS credentials or uses a compatible endpoint.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
CLOUDFRONT_DOMAIN=https://cdn.example.com

# Replace with a long, randomly generated secret.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=60

MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true
FRONTEND_URL=http://localhost:8000
